# 這是您的 NanoClaw 設定檔
# 請將您的 API 金鑰填入引號中，並將此檔案重新命名為 .env

# 助理名稱 (請保留 "赫密士" 以啟用 asis 的預設模型)
ASSISTANT_NAME="赫密士"

# Google AI Studio API Key (Gemini)
GOOGLE_API_KEY="在這裡貼上您的 Google API Key"

# OpenRouter API Key
OPENROUTER_API_KEY="在這裡貼上您的 OpenRouter API Key"

# Auto commit safety flag: set to "true" to allow auto commits when suggested
# Default: false
AUTO_COMMIT_ENABLED="false"
